{
  "version": "1",
  "catalogBaseUrl": "https://ismaeltorres00.github.io/opencode-company-toolkit/catalogs",
  "scopes": {
    "global": {
      "description": "Capacidades comunes para todos los proyectos"
    },
    "dotnet": {
      "description": "Capacidades para proyectos .NET"
    },
    "node": {
      "description": "Capacidades para proyectos Node.js"
    },
    "frontend": {
      "description": "Capacidades para proyectos frontend"
    }
  },
  "agents": {
    "code-reviewer": {
      "source": "agents/code-reviewer.md",
      "description": "Revision de codigo en modo solo lectura"
